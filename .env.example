# Conexão com o PostgreSQL local
# Troque a senha e ajuste usuário/host se necessário.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/gerenciador?schema=public"

# Better Auth
# Gere um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Login com Google (OAuth)
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# e cadastre o redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed de demonstração
# E-mail do usuário que receberá os projetos de exemplo criados pelo seed.
SEED_USER_EMAIL="dev@email.com"
