generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum StatusProjeto {
  ativo
  iniciando
  finalizando
  concluido
  ideia
}

enum ColunaKanban {
  to
  doing
  done
}

model Projeto {
  id           String        @id
  nome         String        @db.VarChar(120)
  descricao    String        @db.VarChar(600)
  status       StatusProjeto @default(ativo)
  stack        String[]
  progresso    Int?
  prazo        DateTime?     @db.Date
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  tarefas      Tarefa[]

  @@index([status])
  @@map("projetos")
}

model Tarefa {
  id           String       @id @default(cuid())
  titulo       String       @db.VarChar(200)
  descricao    String?      @db.VarChar(600)
  coluna       ColunaKanban @default(to)
  ordem        Int          @default(0)
  projetoId    String       @map("projeto_id")
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")
  projeto      Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId, coluna, ordem])
  @@map("tarefas")
}
